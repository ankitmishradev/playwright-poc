{
    "name": "playwright-poc",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "playwright test",
        "test:dev": "ENV=dev playwright test",
        "test:qa": "ENV=qa playwright test",
        "test:prod": "ENV=prod playwright test",
        "test:smoke": "PROFILE=smoke playwright test",
        "test:regression": "PROFILE=regression playwright test",
        "test:headed": "HEADLESS=false playwright test --headed",
        "test:ui": "playwright test --ui",
        "test:debug": "HEADLESS=false playwright test --debug",
        "codegen": "playwright codegen https://demo.playwright.dev/todomvc",
        "report": "playwright show-report playwright-report",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "type-check": "tsc --noEmit",
        "lint-staged": "lint-staged",
        "clean": "rm -rf playwright-report test-results"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.0",
        "@types/node": "^26.6.5",
        "dotenv": "^18.0.7",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-playwright": "^2.12.1",
        "eslint-plugin-prettier": "^5.5.7",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.2"
    }
}
