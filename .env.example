# Copy to .env.dev / .env.qa / .env.prod and fill in per-environment values.
# .env holds shared defaults, .env.local holds personal overrides (both gitignored).
# Precedence: shell/CI env > .env.local > .env.<ENV> > .env

BASE_URL=https://demo.playwright.dev

# chromium | firefox | webkit
BROWSER=chromium

# smoke | regression | all
PROFILE=all

# --- Optional runtime overrides ---
# HEADLESS=false
# RETRIES=1
# WORKERS=4
# ACTION_TIMEOUT=15000
# NAVIGATION_TIMEOUT=60000
# EXPECT_TIMEOUT=10000
# TEST_TIMEOUT=60000
