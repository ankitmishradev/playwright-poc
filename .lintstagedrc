{
    "src/**/*.{ts,js,cjs,mjs}": ["npm run lint", "npm run format"],
    "config/**/*.{ts,js,cjs,mjs,json}": ["npm run lint", "npm run format"],
    "tests/**/*.{ts,js,cjs,mjs}": ["npm run lint", "npm run format"],
    "test-data/**/*.{ts,js,cjs,mjs,json}": ["npm run lint", "npm run format"],
    "scripts/**/*.{ts,js,cjs,mjs}": ["npm run lint", "npm run format"],
    "*.{json,md,yml,yaml}": ["npm run format"]
}
